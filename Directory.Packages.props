<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <PropertyGroup>
    <MicrosoftNet10RuntimeVersion>10.0.14</MicrosoftNet10RuntimeVersion>
    <MicrosoftNet11RuntimeVersion>11.0.0-rc.3.26522.148</MicrosoftNet11RuntimeVersion>
    <MicrosoftNetRuntimeVersion>$(MicrosoftNet10RuntimeVersion)</MicrosoftNetRuntimeVersion>
    <MicrosoftNetRuntimeVersion Condition="'$(TargetFramework)' == 'net11.0'">$(MicrosoftNet11RuntimeVersion)</MicrosoftNetRuntimeVersion>
    <MicrosoftNETTestSdkVersion>18.11.0</MicrosoftNETTestSdkVersion>
    <MicrosoftTestingPlatformVersion>2.5.1</MicrosoftTestingPlatformVersion>
    <MoqVersion>4.21.0</MoqVersion>
    <NugetPackageVersion>7.9.0</NugetPackageVersion>
    <XunitV3Version>4.0.2</XunitV3Version>
    <XunitRunnerVisualstudioVersion>4.0.1</XunitRunnerVisualstudioVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="LinqKit.Microsoft.EntityFrameworkCore" Version="10.1.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.AzureDevOpsReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="$(MicrosoftTestingPlatformVersion)" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Moq" Version="$(MoqVersion)" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NuGet.Packaging" Version="$(NugetPackageVersion)" />
    <PackageVersion Include="NuGet.Versioning" Version="$(NugetPackageVersion)" />
    <PackageVersion Include="ReportGenerator.Core" Version="5.5.11" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.Linq.Async" Version="7.0.1" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualstudioVersion)" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="$(XunitV3Version)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'netstandard2.0'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="System.Collections.Immutable" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="System.Reflection.Metadata" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftNet10RuntimeVersion)" />
    <PackageVersion Include="System.Text.Json" Version="$(MicrosoftNet10RuntimeVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="System.Collections.Immutable" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="System.Reflection.Metadata" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(MicrosoftNet11RuntimeVersion)" />
    <PackageVersion Include="System.Text.Json" Version="$(MicrosoftNet11RuntimeVersion)" />
  </ItemGroup>
</Project>
